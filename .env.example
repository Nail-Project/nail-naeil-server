PORT=

# DB 연결 (애플리케이션 런타임 및 Prisma CLI 공용)
# 예: mysql://user:password@localhost:3306/nail_nae_il
DATABASE_URL=

# JWT
JWT_ACCESS_SECRET=
JWT_EXPIRES_IN=
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=

# 소셜 로그인 - 카카오 (developers.kakao.com > 플랫폼 키 / 카카오 로그인)
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:3000/api/v1/auth/kakao/callback

# 소셜 로그인 - 네이버 (developers.naver.com > 애플리케이션)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_REDIRECT_URI=http://localhost:3000/api/v1/auth/naver/callback

# 소셜 로그인 성공 후 앱으로 토큰을 돌려줄 딥링크 (안드로이드 담당과 스킴 협의)
APP_AUTH_DEEPLINK=nailnaeil://auth

# 공공데이터포털에서 발급받은 소상공인시장진흥공단 상가정보 API 일반 인증키
SBIZ_SERVICE_KEY=
# 기본값: https://apis.data.go.kr/B553077/api/open/sdsc2
SBIZ_API_BASE_URL=
# 기본값: 10000ms
SBIZ_API_TIMEOUT_MS=10000
# 관리자 샵 동기화 API의 x-admin-sync-key 헤더 검증값
SHOP_SYNC_ADMIN_KEY=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano
OPENAI_API_URL=https://api.openai.com/v1/responses
OPENAI_TIMEOUT_MS=15000

# 관리자 디자인 CRUD API의 x-admin-design-key 헤더 검증값
DESIGN_ADMIN_KEY=
