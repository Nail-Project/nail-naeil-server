generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

model Shop {
  id                     Int                   @id @default(autoincrement())
  dataSource             String?               @map("data_source") @db.VarChar(30)
  externalStoreId        String?               @map("external_store_id") @db.VarChar(50)
  name                   String                @db.VarChar(100)
  phoneNumber            String?               @map("phone_number") @db.VarChar(20)
  address                String                @db.VarChar(255)
  addressDetail          String?               @map("address_detail") @db.VarChar(255)
  provinceCode           String?               @map("province_code") @db.VarChar(10)
  provinceName           String?               @map("province_name") @db.VarChar(50)
  districtCode           String?               @map("district_code") @db.VarChar(10)
  districtName           String?               @map("district_name") @db.VarChar(50)
  adminDongCode          String?               @map("admin_dong_code") @db.VarChar(20)
  adminDongName          String?               @map("admin_dong_name") @db.VarChar(50)
  latitude               Decimal               @db.Decimal(10, 7)
  longitude              Decimal               @db.Decimal(10, 7)
  locationGuide          String?               @map("location_guide") @db.VarChar(255)
  parkingInfo            String?               @map("parking_info") @db.VarChar(255)
  thumbnailImageUrl      String?               @map("thumbnail_image_url") @db.VarChar(500)
  rating                 Decimal               @default(0) @db.Decimal(2, 1)
  reviewCount            Int                   @default(0) @map("review_count")
  businessHours          Json?                 @map("business_hours")
  closedDays             Json?                 @map("closed_days")
  isDataActive           Boolean               @default(true) @map("is_data_active")
  lastSyncedAt           DateTime?             @map("last_synced_at") @db.DateTime(3)
  createdAt              DateTime              @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt              DateTime              @updatedAt @map("updated_at") @db.DateTime(3)
  estimateResponses      EstimateResponse[]
  smsMessages            SmsMessage[]
  estimateRequestTargets EstimateRequestShop[]
  wishes                 WishShop[]
  reviews                ShopReview[]

  @@unique([dataSource, externalStoreId])
  @@index([provinceCode, districtCode, adminDongCode])
  @@map("shops")
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum AuthProvider {
  LOCAL
  KAKAO
  NAVER
}

model User {
  id              Int                @id @default(autoincrement())
  // 이메일은 이제 로그인 식별자가 아니라 프로필 정보다.
  // 소셜(연락처 이메일)은 유니크 보장이 안 되고 미제공될 수 있어 nullable + non-unique로 둔다.
  email           String?            @db.VarChar(100)
  phoneNumber     String?            @map("phone_number") @db.VarChar(20)
  nickname        String?            @db.VarChar(100)
  // 마이페이지에서 수정 가능한 프로필 사진 S3 URL. image 도메인에 업로드 후 URL만 저장한다.
  profileImageUrl String?            @map("profile_image_url") @db.VarChar(255)
  role            UserRole           @default(CUSTOMER)
  createdAt       DateTime           @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.DateTime(3)
  authProviders   UserAuthProvider[]
  refreshTokens   RefreshToken[]
  notifications   Notification[]
  deviceTokens    DeviceToken[]
  reservations    Reservation[]
  wishDesigns     WishDesign[]
  wishShops       WishShop[]
  shopReviews     ShopReview[]
  notificationSetting NotificationSetting?
  subscriptions   Subscription[]

  @@map("users")
}

// NPlus 구독. 결제 연동은 범위 밖(P2)이라 상태와 기간만 관리한다.
// 마이페이지의 NPlus 가입 여부는 "ACTIVE이면서 만료되지 않은" 구독이 존재하는지로 판단한다.
enum SubscriptionPlan {
  NPLUS
}

enum SubscriptionStatus {
  ACTIVE // 구독 중
  EXPIRED // 기간 만료
  CANCELLED // 사용자 해지
}

model Subscription {
  id        Int                @id @default(autoincrement())
  userId    Int                @map("user_id")
  plan      SubscriptionPlan   @default(NPLUS)
  status    SubscriptionStatus @default(ACTIVE)
  startedAt DateTime           @default(now()) @map("started_at") @db.DateTime(3)
  // null이면 무기한(해지 전까지 유효), 값이 있으면 그 시점 이후 만료로 본다.
  expiresAt DateTime?          @map("expires_at") @db.DateTime(3)
  createdAt DateTime           @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime           @updatedAt @map("updated_at") @db.DateTime(3)

  // 회원 탈퇴 시 구독도 함께 삭제되도록 Cascade.
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 특정 사용자의 활성 구독을 조회하는 접근 패턴에 맞춘 인덱스.
  @@index([userId, status])
  @@map("subscriptions")
}

model WishShop {
  id        Int      @id @default(autoincrement())
  shopId    Int      @map("shop_id")
  userId    Int      @map("user_id")
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([shopId, userId])
  @@index([userId, createdAt, id])
  @@map("wish_shops")
}

model ShopReview {
  id        Int      @id @default(autoincrement())
  shopId    Int      @map("shop_id")
  userId    Int      @map("user_id")
  rating    Int
  content   String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([shopId, userId])
  @@index([shopId, createdAt, id])
  @@map("shop_reviews")
}

// 로컬/소셜 인증 수단을 User와 분리해 관리한다.
// 한 User가 여러 provider(로컬+카카오+네이버)를 연결할 수 있다.
model UserAuthProvider {
  id           Int          @id @default(autoincrement())
  userId       Int          @map("user_id")
  provider     AuthProvider
  // LOCAL: loginId, KAKAO/NAVER: 각 소셜의 고유 회원 id
  providerId   String       @map("provider_id") @db.VarChar(255)
  // LOCAL만 사용(bcrypt 해시), 소셜은 null
  passwordHash String?      @map("password_hash") @db.VarChar(255)
  createdAt    DateTime     @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.DateTime(3)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@index([userId])
  @@map("user_auth_providers")
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  // 원문 JWT가 아닌 SHA-256 해시(hex, 64자)만 저장한다 (DB 유출 시 재사용 방지)
  token     String   @unique @db.VarChar(512)
  userId    Int      @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("refresh_tokens")
}

// 인앱 알림. 견적/예약 상태 변경 등 이벤트를 사용자별로 쌓아두고 앱에서 조회한다.
// FCM 외부 발송은 후속 단계에서 이 데이터를 재사용해 얹는다.
enum NotificationType {
  ESTIMATE_RESPONSE // 견적 응답 도착
  RESERVATION_STATUS // 예약 상태 변경(확정/취소 등) - 레거시, 신규 코드는 아래 세분화된 타입을 쓴다.
  LOWER_ESTIMATE // 더 낮은 견적 도착
  ESTIMATE_CLOSED // 견적 응답 마감(요청 만료)
  RESERVATION_CONFIRMED // 예약 확정
  RESERVATION_CANCELLED // 예약 취소
  RESERVATION_DAY_BEFORE // 예약 하루 전
  RESERVATION_DAY_OF // 예약 당일
}

model Notification {
  id        Int              @id @default(autoincrement())
  userId    Int              @map("user_id")
  type      NotificationType
  title     String           @db.VarChar(100)
  body      String           @db.VarChar(255)
  // 알림 클릭 시 이동에 필요한 관련 리소스 식별자 등을 담는다(예: { "reservationId": 12 }).
  data      Json?
  isRead    Boolean          @default(false) @map("is_read")
  readAt    DateTime?        @map("read_at") @db.DateTime(3)
  createdAt DateTime         @default(now()) @map("created_at") @db.DateTime(3)

  // 회원 탈퇴 시 알림도 함께 삭제되도록 Cascade.
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 내 알림 목록을 최신순으로, 안읽음 필터와 함께 조회하는 접근 패턴에 맞춘 인덱스.
  @@index([userId, createdAt])
  @@map("notifications")
}

// 사용자별 알림 수신 설정. 각 카테고리별 ON/OFF를 관리한다.
// 알림 생성 시 이 설정을 확인해 OFF인 카테고리는 발송을 건너뛴다(후속 단계).
// 행이 없으면 전부 ON(기본값)으로 간주하며, 수정 시점에 lazy하게 생성한다.
model NotificationSetting {
  id                 Int      @id @default(autoincrement())
  // 사용자당 설정은 하나뿐이라 unique. upsert의 기준 키로도 사용한다.
  userId             Int      @unique @map("user_id")
  estimateEnabled    Boolean  @default(true) @map("estimate_enabled")
  reservationEnabled Boolean  @default(true) @map("reservation_enabled")
  marketingEnabled   Boolean  @default(true) @map("marketing_enabled")
  createdAt          DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  // 회원 탈퇴 시 설정도 함께 삭제되도록 Cascade.
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_settings")
}

// FCM 푸시 발송 대상이 되는 사용자별 디바이스 토큰.
// 앱이 기기에서 발급받은 FCM 등록 토큰을 서버에 저장해 두고, 알림 발송 시 userId로 조회해 발송한다.
enum DevicePlatform {
  ANDROID
  IOS
}

model DeviceToken {
  id       Int            @id @default(autoincrement())
  userId   Int            @map("user_id")
  // FCM 등록 토큰. 기기당 유일하므로 unique로 두고, 재로그인 등으로 소유자가 바뀌면 upsert로 갱신한다.
  // 토큰은 대소문자를 구분하므로 DB 컬럼 콜레이션을 utf8mb4_bin으로 지정한다(마이그레이션 SQL 참고).
  // Prisma 스키마는 컬럼 콜레이션 표현을 지원하지 않아 마이그레이션에서만 관리한다.
  token    String         @unique @db.VarChar(255)
  platform DevicePlatform @default(ANDROID)

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  // 회원 탈퇴 시 디바이스 토큰도 함께 삭제되도록 Cascade.
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 특정 사용자의 모든 토큰을 조회해 발송하는 접근 패턴에 맞춘 인덱스.
  @@index([userId])
  @@map("device_tokens")
}

enum EstimateResponseStatus {
  SUBMITTED
  ACCEPTED
  REJECTED
}

enum SmsDirection {
  OUTBOUND
  INBOUND
}

enum SmsStatus {
  PENDING
  SENT
  PARSED
  FAILED
}

model EstimateResponse {
  id                       Int                    @id @default(autoincrement())
  requestId                Int                    @map("request_id")
  shopId                   Int                    @map("shop_id")
  totalPrice               Int?                   @map("total_price")
  basePrice                Int?                   @map("base_price")
  removalPrice             Int?                   @map("removal_price")
  // Figma 가격 세부내역의 "디자인 추가"/"옵션 추가" 두 줄에 대응시키려고 기존 extraPrice를
  // 쪼갠 컬럼(2026-08-09). designExtraPrice는 기존 extraPrice 값을 그대로 이어받는다.
  designExtraPrice         Int?                   @map("design_extra_price")
  optionExtraPrice         Int?                   @map("option_extra_price")
  memo                     String?                @db.Text
  estimatedDurationMinutes Int                    @default(60) @map("estimated_duration_minutes")
  canProvideService        Boolean                @default(true) @map("can_provide_service")
  isRemovalIncluded        Boolean                @default(false) @map("is_removal_included")
  status                   EstimateResponseStatus @default(SUBMITTED)
  createdAt                DateTime               @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt                DateTime               @updatedAt @map("updated_at") @db.DateTime(3)
  request                  EstimateRequest        @relation(fields: [requestId], references: [id])
  shop                     Shop                   @relation(fields: [shopId], references: [id])
  proposalTimes            ShopProposalTime[]
  smsMessages              SmsMessage[]
  // 취소된 예약은 같은 견적으로 재예약을 허용하기로 정책 변경(2026-08-03, A1)하면서
  // Reservation.proposalId의 @unique 제약을 제거했다 - 1건의 견적에 여러 예약(취소분 포함)이
  // 남을 수 있어 1:1이 아닌 1:N 관계로 바뀐다.
  reservations             Reservation[]

  @@unique([requestId, shopId])
  @@map("estimate_responses")
}

model ShopProposalTime {
  id               Int              @id @default(autoincrement())
  proposalId       Int              @map("proposal_id")
  proposalDatetime DateTime         @map("proposal_datetime") @db.DateTime(3)
  isSelected       Boolean          @default(false) @map("is_selected")
  proposal         EstimateResponse @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@map("shop_proposal_times")
}

model SmsMessage {
  id                 Int               @id @default(autoincrement())
  source             String            @db.VarChar(100)
  messageId          String            @map("message_id") @db.VarChar(100)
  direction          SmsDirection
  rawPayload         Json              @map("raw_payload")
  status             SmsStatus         @default(PENDING)
  errorMessage       String?           @map("error_message") @db.Text
  requestId          Int?              @map("request_id")
  shopId             Int?              @map("shop_id")
  estimateResponseId Int?              @map("estimate_response_id")
  createdAt          DateTime          @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.DateTime(3)
  request            EstimateRequest?  @relation(fields: [requestId], references: [id], onDelete: SetNull)
  shop               Shop?             @relation(fields: [shopId], references: [id], onDelete: SetNull)
  estimateResponse   EstimateResponse? @relation(fields: [estimateResponseId], references: [id], onDelete: SetNull)

  @@unique([source, direction, messageId])
  @@map("sms_messages")
}

// ─── Estimate Request 도메인 ──────────────────────────────────────────────────

enum NailType {
  HAND // 손 네일
  PEDICURE // 발 네일
  BOTH // 손 + 발
}

enum RemovalType {
  EXTENSION // 연장 제거
  PARTS // 부분 제거
  BASIC // 기본 제거
  NONE // 제거 없음
}

enum PreferredTime {
  AM // 오전
  PM // 오후
  EVENING // 저녁
  ANY // 무관
}

enum RecommendType {
  BALANCED // 균형 추천
  CLOSE // 가까운 순
  WIDE // 넓은 범위
  CHEAP // 저렴한 순
}

enum EstimateStatus {
  MATCHING // 샵 매칭 중 (견적 응답 대기)
  COMPLETED // 견적 수락 완료
  EXPIRED // 요청 기간 만료
}

model EstimateRequest {
  id            Int                   @id @default(autoincrement())
  nailType      NailType              @map("nail_type")
  removalType   RemovalType           @map("removal_type")
  startDate     DateTime              @map("start_date") @db.Date
  endDate       DateTime              @map("end_date") @db.Date
  preferredTime PreferredTime         @map("preferred_time")
  recommendType RecommendType         @map("recommend_type")
  description   String?               @db.Text
  latitude      Decimal?              @db.Decimal(10, 7)
  longitude     Decimal?              @db.Decimal(10, 7)
  status        EstimateStatus        @default(MATCHING)
  // TODO: [yej] User 모델 추가 후 @relation 연결
  userId        Int                @map("user_id")
  // 카탈로그 디자인을 그대로 견적받은 경우에만 채워진다. 사용자가 직접 사진을
  // 올려 요청한 경우 null이며, 참조 디자인이 삭제돼도 요청 기록은 남아야 하므로
  // SetNull로 둔다.
  designId      Int?               @map("design_id")
  createdAt     DateTime           @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt     DateTime           @updatedAt @map("updated_at") @db.DateTime(3)
  design        Design?            @relation(fields: [designId], references: [id], onDelete: SetNull)
  images        RequestImage[]
  proposals     EstimateResponse[]
  smsMessages   SmsMessage[]
  targetShops   EstimateRequestShop[]

  @@index([designId])
  @@map("estimate_requests")
}

model EstimateRequestShop {
  requestId Int             @map("request_id")
  shopId    Int             @map("shop_id")
  createdAt DateTime        @default(now()) @map("created_at") @db.DateTime(3)
  request   EstimateRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  shop      Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@id([requestId, shopId])
  @@index([shopId, createdAt])
  @@map("estimate_request_shops")
}

model RequestImage {
  id        Int             @id @default(autoincrement())
  imageUrl  String          @map("image_url") @db.VarChar(255)
  requestId Int             @map("request_id")
  createdAt DateTime        @default(now()) @map("created_at") @db.DateTime(3)
  request   EstimateRequest @relation(fields: [requestId], references: [id])

  @@map("request_images")
}

// ─── Reservation 도메인 ────────────────────────────────────────────────────

enum ReservationStatus {
  CONFIRMED
  COMPLETED
  CANCELLED
}

model Reservation {
  id           BigInt            @id @default(autoincrement())
  // EstimateResponse.id가 Int라 FK 타입을 맞춤 (Prisma 제약상 불가피). Int 유지로 확정(2026-07-25).
  // ERD는 한때 proposal_id를 bigint로 그렸으나 실제 구현(Int)과 안 맞아 ERD 쪽을 수정 요청, 2026-07-25 반영 완료.
  // [malibu][A1] @unique 제거(2026-08-03): 취소된 예약은 같은 견적으로 재예약을 허용하는 정책으로 바뀌면서
  // proposalId 단위 유일성 제약을 DB에 걸어둘 수 없게 됐다. 대신 "취소되지 않은 예약" 단위 중복은
  // 애플리케이션 레벨(existsByProposalId의 status != CANCELLED 조건)에서 막는다.
  proposalId   Int               @map("proposal_id")
  userId       Int               @map("user_id")
  reservedAt   DateTime          @map("reserved_at") @db.DateTime(3)
  status       ReservationStatus @default(CONFIRMED)
  // 예약 취소 사유 - Figma 라디오 선택지("개인 사정" 등)를 자유 문자열로 저장, 취소하지 않은 예약은 null.
  cancelReason String?           @map("cancel_reason") @db.VarChar(255)
  createdAt    DateTime          @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt    DateTime          @updatedAt @map("updated_at") @db.DateTime(3)
  proposal     EstimateResponse  @relation(fields: [proposalId], references: [id])
  user         User              @relation(fields: [userId], references: [id])

  @@index([userId, status, reservedAt])
  @@index([proposalId])
  @@map("reservations")
}

// ─── Design 도메인 ──────────────────────────────────────────────────────────

model Design {
  id               Int           @id @default(autoincrement())
  title            String        @db.VarChar(100)
  imageUrl         String        @map("image_url") @db.VarChar(255)
  viewCount        Int           @default(0) @map("view_count")
  durationMinutes  Int           @map("duration_minutes")
  // TODO: [malibu] 값 종류(전체 옵션 목록) 확정되면 enum으로 전환
  difficulty       String        @db.VarChar(20)
  // TODO: [malibu] 값 종류(전체 옵션 목록) 확정되면 enum으로 전환
  recommendedShape String        @map("recommended_shape") @db.VarChar(20)
  description      String        @db.Text
  createdAt        DateTime      @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.DateTime(3)
  images           DesignImage[]
  wishes           WishDesign[]
  tags             DesignTag[]
  estimateRequests EstimateRequest[]

  // 피드 정렬(createdAt desc)이 데이터 증가 시 풀 테이블 스캔이 되지 않도록 인덱스를 둔다.
  @@index([createdAt])
  @@map("designs")
}

model DesignImage {
  id        Int      @id @default(autoincrement())
  imageUrl  String   @map("image_url") @db.VarChar(255)
  designId  Int      @map("design_id")
  design    Design   @relation(fields: [designId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  @@map("design_images")
}

model WishDesign {
  id        Int      @id @default(autoincrement())
  designId  Int      @map("design_id")
  userId    Int      @map("user_id")
  design    Design   @relation(fields: [designId], references: [id], onDelete: Cascade)
  // feat/auth 병합 전엔 User 테이블이 없어 FK를 걸 수 없었다(2026-08-02, CodeRabbit 리뷰로
  // 재확인 후 연결). 유저가 삭제되면 그 유저의 찜 기록도 같이 정리한다.
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  @@unique([designId, userId])
  // 찜한 디자인 목록(findWishlistByUserId)이 userId로 필터링 후 createdAt/id로 정렬한다.
  // 위 unique 인덱스는 designId가 선두 컬럼이라 이 조회엔 못 쓰여서 별도로 둔다.
  @@index([userId, createdAt, id])
  @@map("wish_designs")
}

// AI 자동 태깅 + 인스타그램 스타일 태그 클릭 탐색을 위한 정규화된 태그.
// 예전엔 Design.tag(콤마로 이어붙인 문자열) 하나였는데, 태그 단위 검색/집계가
// 불가능해서 다대다 관계로 교체했다(2026-08-02, 실사용 데이터 없어서 컬럼 삭제로 바로 전환).
model Tag {
  id        Int         @id @default(autoincrement())
  name      String      @unique @db.VarChar(50)
  createdAt DateTime    @default(now()) @map("created_at") @db.DateTime(3)
  designs   DesignTag[]

  @@map("tags")
}

model DesignTag {
  designId  Int      @map("design_id")
  tagId     Int      @map("tag_id")
  design    Design   @relation(fields: [designId], references: [id], onDelete: Cascade)
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  @@id([designId, tagId])
  @@map("design_tags")
}
