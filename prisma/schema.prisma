generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Shop {
  id            Int      @id @default(autoincrement())
  name          String   @db.VarChar(100)
  phoneNumber   String?  @map("phone_number") @db.VarChar(20)
  address       String   @db.VarChar(255)
  addressDetail String?  @map("address_detail") @db.VarChar(255)
  locationGuide String?  @map("location_guide") @db.VarChar(255)
  parkingInfo   String?  @map("parking_info") @db.VarChar(255)
  latitude      Decimal  @db.Decimal(10, 7)
  longitude     Decimal  @db.Decimal(10, 7)
  createdAt     DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  @@map("shops")
}

enum NailType {
  HAND
  PEDICURE
  BOTH
}

enum RemovalType {
  EXTENSION
  PARTS
  BASIC
  NONE
}

enum PreferredTime {
  AM
  PM
  EVENING
  ANY
}

enum RecommendType {
  BALANCED
  CLOSE
  WIDE
  CHEAP
}

enum EstimateStatus {
  MATCHING
  COMPLETED
  EXPIRED
}

model EstimateRequest {
  id            BigInt         @id @default(autoincrement())
  nailType      NailType       @map("nail_type")
  removalType   RemovalType    @map("removal_type")
  startDate     DateTime       @map("start_date") @db.Date
  endDate       DateTime       @map("end_date") @db.Date
  preferredTime PreferredTime  @map("preferred_time")
  description   String?        @db.Text
  recommendType RecommendType  @map("recommend_type")
  status        EstimateStatus @default(MATCHING)
  createdAt     DateTime       @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.DateTime(3)
  userId        BigInt         @map("user_id")

  images        RequestImage[]

  @@map("estimate_request")
}

model RequestImage {
  id         BigInt          @id @default(autoincrement())
  imageUrl   String          @map("image_url") @db.VarChar(255)
  createdAt  DateTime        @default(now()) @map("created_at") @db.DateTime(3)
  requestId  BigInt          @map("request_id")

  request    EstimateRequest @relation(fields: [requestId], references: [id])

  @@map("request_image")
}